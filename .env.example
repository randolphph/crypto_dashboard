# =========================
# Exchanges
# =========================

# Binance (read-only key)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENABLE_GRID_BOT=false

# OKX (read-only key)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Deribit (options)
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# =========================
# On-chain
# =========================

# OKX Web3 API — multi-chain wallet balance resolution
# https://web3.okx.com/onchainos/dev-portal/project
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_PASSPHRASE=
OKX_WEB3_PROJECT_ID=

# Custom RPCs (optional; defaults to public nodes if omitted)
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=

# =========================
# Brokers
# =========================

# Longport OpenAPI — https://open.longportapp.com/
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=

# IBKR Flex Query (Account Management → Reports → Flex Queries)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# =========================
# Infrastructure
# =========================

# Upstash Redis (used for A/HK/US/KR quote cache + IBKR Flex snapshot cache)
# Vercel KV-style names (KV_REST_API_*) are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MSTR mNAV backend (separate service; see README "部署架构")
MNAV_API_BASE=
MNAV_API_TOKEN=

# Bearer token required for POST /api/strategy (AI-pushed strategy tables).
# Generate something random and unguessable (e.g. `openssl rand -hex 32`).
# Leave empty to fully disable the push endpoint.
STRATEGY_PUSH_TOKEN=
